# Chain Deployment Studio — Node backend configuration

# HTTP port
PORT=8000

# Where deployments are persisted (mount a disk here on your host to keep them)
# DATA_FILE=/data/deployments.json

# ── LIVE chain node ────────────────────────────────────────────────────
# Defaults point at a live public Cosmos Hub node so the site connects to a
# real chain out of the box. Replace with your own skymetricd node to go
# sovereign:
#   CHAIN_RPC=https://rpc.skymetric.dev
#   CHAIN_REST=https://rest.skymetric.dev
#   CHAIN_ID=skymetric-1
#   CHAIN_BECH32=agentic
#   CHAIN_DENOM=usky
#   CHAIN_SYMBOL=SKY
CHAIN_RPC=https://cosmos-rpc.publicnode.com
CHAIN_REST=https://cosmos-rest.publicnode.com
CHAIN_BECH32=agentic
CHAIN_DENOM=usky
CHAIN_SYMBOL=SKY
