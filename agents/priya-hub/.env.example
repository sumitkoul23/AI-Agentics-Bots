# ── SkyAgents-hub — local environment ────────────────────────────────────────
#
# The hub lives inside the Go binary. The web UI is the gateway.
# Run ./start-hub.sh, then open http://localhost:8080
#
# Quick start (one-time):
#   brew install ollama cloudflared
#   ollama pull llama3.2        # or: llama3.1, mistral, phi3, gemma2
#   cd agents/priya-hub && go build -o skyagents-hub .
#   ./start-hub.sh              # builds, loads this .env, starts hub + tunnel

# ── LLM model attachment ──────────────────────────────────────────────────────
# Ollama API endpoint — point at a remote GPU box to offload inference
OLLAMA_HOST=http://localhost:11434

# Override the auto-selected model. Leave blank to let the hub pick the best
# available model automatically (recommended).
# Examples: llama3.2 | llama3.1 | mistral | phi3:mini | gemma2 | qwen2.5
# For NLP / fine-tuned models pulled via Ollama, enter the model name here.
OLLAMA_MODEL=

# HTTP port for the gateway UI and API (default: 8080)
PORT=8080

# Set CLI=1 to run in interactive shell mode instead of HTTP server
CLI=

# ── IP Tunneling — remote access for training & collaboration ─────────────────
# Exposes the hub over the internet so remote devices, phones, and collaborators
# can connect, send conversations, and contribute to the training corpus.
#
# TUNNEL=cloudflared   Cloudflare tunnel (recommended — no account needed)
#   Install: brew install cloudflared  (mac)
#            sudo apt install cloudflared  (linux/ubuntu)
#   After start: public URL printed to console; scan QR at GET /tunnel/qr
#
# TUNNEL=ngrok         ngrok tunnel (requires ngrok binary + auth token)
#   Install: https://ngrok.com/download  — then: ngrok config add-authtoken <token>
#
# TUNNEL=off           disabled
TUNNEL=cloudflared

# ── NLP training data pipeline ────────────────────────────────────────────────
# Directory containing .jsonl training corpora to seed agent memory on startup.
# Each line must be: {"agent":"<id>","key":"<fact_key>","value":"<fact_value>"}
# Leave blank to skip (agents start with built-in seed data only).
NLP_TRAIN_DIR=

# Path to a single training JSONL file (alternative to NLP_TRAIN_DIR)
NLP_TRAIN_FILE=

# Expose POST /train endpoint so remote devices can push training data over
# the tunnel (useful for distributed learning across devices). Set to 1 to enable.
NLP_TRAIN_ENDPOINT=1

# ── MCP Tools (system control for agents) ────────────────────────────────────
# MCP_FILESYSTEM=1  allow agents to read/write local files
# MCP_SHELL=1       allow agents to execute shell commands (powerful!)
# MCP_FETCH=1       allow agents to fetch URLs
MCP_FILESYSTEM=
MCP_SHELL=
MCP_FETCH=

# ── Voice: Speech-to-Text (Whisper) ──────────────────────────────────────────
# Install: brew install whisper-cpp   OR   git clone + build whisper.cpp
# Model:   wget https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin
WHISPER_BIN=
WHISPER_MODEL=

# ── Voice: Text-to-Speech (Piper) ────────────────────────────────────────────
# Install: pip install piper-tts   OR   download binary from github.com/rhasspy/piper
# Model:   piper --download-voice en_US-amy-medium
PIPER_BIN=
PIPER_MODEL=

# ── Vision (image understanding) ─────────────────────────────────────────────
# Requires a vision-capable Ollama model (llava, moondream, bakllava)
# ollama pull llava
VISION_MODEL=

# ── Reasoning mode ───────────────────────────────────────────────────────────
# chain-of-thought  adds a thinking pass before every answer
# off               disabled (default)
REASONING_MODE=chain-of-thought

# ── Optional: Teneo network deployment ────────────────────────────────────────
PRIVATE_KEY=
