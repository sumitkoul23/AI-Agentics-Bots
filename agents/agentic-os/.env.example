# Agentic OS — environment configuration
# Copy to .env and fill in your keys.

# ── LLM providers ────────────────────────────────────────────────────────
# At least one is required for agent LLM calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model for agents (can be overridden per-agent)
AGENT_DEFAULT_MODEL=gpt-4o-mini

# ── Web search ───────────────────────────────────────────────────────────
# Optional: provide Brave or Serper keys for better search results.
# Without keys, DuckDuckGo HTML scraping is used (no registration needed).
BRAVE_SEARCH_KEY=
SERPER_API_KEY=

# ── Data persistence ─────────────────────────────────────────────────────
AGENTIC_DATA_DIR=data

# ── Server ───────────────────────────────────────────────────────────────
PORT=8001
AGENTIC_WORKERS=4
